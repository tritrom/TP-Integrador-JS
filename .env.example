# Copia este archivo como ".env" y completá los valores según tu entorno.
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=wallet_user
DB_PASSWORD=tu_contraseña_segura
DB_NAME=wallet_db

# Clave para firmar los tokens JWT (cambiarla en producción)
JWT_SECRET=tu_clave_secreta_larga